OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"

# Email Configuration (for yagmail or smtplib)
EMAIL_SENDER_ADDRESS="your_email@example.com"
EMAIL_SENDER_PASSWORD="your_email_password_or_app_password" # For Gmail, use an App Password if 2FA is enabled
EMAIL_SMTP_SERVER="smtp.example.com" # e.g., smtp.gmail.com
EMAIL_SMTP_PORT="587" # e.g., 587 for TLS, 465 for SSL (yagmail often handles this well)
